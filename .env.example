# SaansSetu AI — Environment Configuration
# ==============================================================================
# NO ENVIRONMENT VARIABLES ARE REQUIRED to run SaansSetu AI.
# The application is 100% self-contained and fully functional out-of-the-box:
# - Live atmospheric forecasts use free Open-Meteo European CAMS data feeds.
# - The conversational assistant runs on an autonomous, context-aware deterministic
#   engine covering 11 environmental scientific domains in Hindi & English.
# - All CPCB AQI calculations, routine planning, and CADR calculations run locally.
# ==============================================================================

# (OPTIONAL) Google Gemini API key
# Leave blank or omit. If unset, the application uses the deterministic intelligence engine.
GEMINI_API_KEY=

# (OPTIONAL) Public App URL (Default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
